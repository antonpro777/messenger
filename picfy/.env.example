# Add these values in Vercel Project Settings -> Environment Variables.
# Never commit a real .env file or paste secrets into chat.
SECRET_KEY=generate-a-long-random-secret
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require
SUPABASE_URL=https://gamigpluabnzzynecbrl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-side-secret-key-only

# SMTP account used to send Picfy login and registration codes.
# Keep SMTP_PASSWORD private; add it directly in Vercel, not in GitHub or chat.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-sender@example.com
SMTP_PASSWORD=your-mail-provider-app-password
MAIL_FROM=your-sender@example.com
